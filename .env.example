# Canonical public origin; confirm the real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://keyamsports-new.vercel.app
GOOGLE_SITE_VERIFICATION=

# Existing publications are preserved in data/published.json without Supabase.
# Use database mode only after migrating/reviewing the existing publications.
# In database mode, read failures return no articles rather than repository fallback.
KEYAM_CONTENT_SOURCE=auto

# Existing Supabase project; apply reviewed supabase/migrations through GitHub.
# Do not expose the service-role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Single-editor access. Use a long, unique random password.
# Production login/runs use the private PostgreSQL limiter or optional Upstash.
ADMIN_PASSWORD=
# Preferred password when set; used for login and session signing.
ADMIN_PASSWORD_2=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Off by default. Enable only after choosing API-accessible models and budgets.
KEYAM_ENABLE_AI=false
OPENAI_API_KEY=
KEYAM_MAX_AI_RUNS_PER_DAY=5
# Disabled until database, models, source terms and a real private draft are verified.
KEYAM_ENABLE_SCHEDULED_AGENTS=false
# At least 32 random characters, server-only; Vercel sends Bearer authorization.
CRON_SECRET=
# Verify these identifiers against your OpenAI API account before activation.
KEYAM_MODEL_SCOUT=
KEYAM_MODEL_WRITER=
KEYAM_MODEL_STATS=
KEYAM_MODEL_EDITOR=
KEYAM_MODEL_SENIOR_EDITOR=
KEYAM_MODEL_INJURY=

# Only enable after reviewing provider plan and commercial-use permissions.
# Current score adapter provides date snapshots, not real-time guarantees.
THESPORTSDB_API_KEY=
ODDS_API_KEY=
PIXABAY_API_KEY=

# Unverified bundled archive is opt-in in development ONLY; never in production.
KEYAM_ENABLE_SAMPLE_CONTENT=false

# Existing optional advertisements; current CSP needs provider review before use.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSLOT_HOME_TOP=
NEXT_PUBLIC_ADSLOT_HOME_INFEED=
NEXT_PUBLIC_ADSLOT_SIDEBAR_TOP=
